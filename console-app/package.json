{
  "name": "addressing-console",
  "version": "0.1.0-demo",
  "private": true,
  "description": "DEMO/REFERENCE SCAFFOLD for the Addressing Console described in ../Console.md. Not the full 'done means' implementation.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "check:links": "node scripts/check-links.mjs",
    "smoke": "node scripts/run-smoke.mjs",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --format=esm --outfile=dist-mcp/server.mjs",
    "mcp": "npm run build:mcp && node dist-mcp/server.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
