<mxfile host="app.diagrams.net">
  <diagram name="Old to New Infrastructure" id="old-to-new">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== LEFT PANEL: OLD INFRASTRUCTURE ===== -->
        <mxCell id="old_panel" value="OLD INFRASTRUCTURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="420" height="780" as="geometry" />
        </mxCell>

        <mxCell id="old_system" value="Legacy application&#10;(undocumented codebase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="old_deploy" value="Manual deploys&#10;(no CI, no Terraform)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="old_tests" value="No tests&#10;(regressions found in production)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="old_docs" value="Tribal knowledge&#10;(specs live in decks, PDFs, chat threads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="old_sources" value="Sources scattered across:&#10;decks / PDFs / spreadsheets / API specs /&#10;backlogs / screenshots / old codebase /&#10;running system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="340" height="130" as="geometry" />
        </mxCell>

        <mxCell id="old_infra_deployed" value="Deployed on:&#10;hand-configured servers,&#10;no environment parity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="670" width="340" height="90" as="geometry" />
        </mxCell>

        <!-- ===== MIDDLE: SPEC-INGEST TOOL ===== -->
        <mxCell id="tool_panel" value="SPEC-INGEST TOOL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="300" width="360" height="300" as="geometry" />
        </mxCell>

        <mxCell id="tool_read" value="Readers&#10;claim by content, never extension" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="360" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="tool_corpus" value="Corpus&#10;merge + dedupe + contradictions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="tool_profile" value="Profile / architecture&#10;inferred, not authored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="tool_no_model" value="No model / provider SDK / API key&#10;ships in generated output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT PANEL: NEW INFRASTRUCTURE ===== -->
        <mxCell id="new_panel" value="NEW INFRASTRUCTURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;fontSize=16;fontStyle=1;fontFamily=Helvetica;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="40" width="420" height="780" as="geometry" />
        </mxCell>

        <mxCell id="new_app" value="Application&#10;(routes, tests, README)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1080" y="100" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="new_tests" value="Test suite&#10;(unit + smoke, Playwright)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1080" y="200" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="new_ci" value="CI workflow&#10;(green on first push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1080" y="300" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="new_terraform" value="Terraform&#10;(env-specific values left as variables)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1080" y="400" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="new_audit" value="Audit log&#10;(what was read/produced/refused,&#10;no extracted content)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="500" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="new_parity" value="Parity harness&#10;(twinning.mjs proves the rebuild&#10;behaves like what it replaced)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="610" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="new_docker" value="Docker + nginx&#10;deploy, environment parity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1080" y="710" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS ===== -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=3;endArrow=block;html=1;fontFamily=Helvetica;" edge="1" parent="1" source="old_panel" target="tool_panel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;strokeWidth=3;endArrow=block;html=1;fontFamily=Helvetica;" edge="1" parent="1" source="tool_panel" target="new_panel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow_parity" value="verified against" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;dashed=1;html=1;fontFamily=Helvetica;fontSize=11;exitX=0;exitY=0.9;entryX=1;entryY=0.9;" edge="1" parent="1" source="new_parity" target="old_panel">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="730" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
